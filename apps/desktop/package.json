{
  "name": "@ktv/desktop",
  "version": "1.0.0",
  "author": "Karawowke",
  "private": true,
  "type": "module",
  "description": "Karawowke Home KTV — Standalone Desktop Appliance (Linux AppImage / Windows EXE)",
  "main": "dist/main.mjs",
  "scripts": {
    "build:renderer": "vite build -c vite.renderer.config.ts",
    "build:main": "node scripts/build-main.mjs",
    "build": "pnpm --filter @ktv/shared build && pnpm --filter @ktv/pi-daemon build && pnpm build:renderer && pnpm build:main",
    "start": "pnpm build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "dist:win": "pnpm build && electron-builder --win --config electron-builder.yml",
    "dist:linux": "pnpm build && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@ktv/pi-daemon": "workspace:*",
    "@ktv/shared": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.2",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.2",
    "vite": "^8.0.0",
    "zod": "^3.24.2"
  }
}
