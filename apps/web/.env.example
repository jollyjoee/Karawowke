# Client-side public configuration for Next.js / Vinext (apps/web)
# Leave blank during desktop/LAN dev to auto-detect http://<LAN_IP>:4000 and ws://<LAN_IP>:4000/ws!

# Production Raspberry Pi Cloudflare Tunnel endpoints:
# NEXT_PUBLIC_DAEMON_WS_URL=wss://api.yourdomain.com/ws
# NEXT_PUBLIC_DAEMON_API_URL=https://api.yourdomain.com

# Local loopback URL used exclusively by /player on the Raspberry Pi so 1080p video bytes never leave the Pi:
NEXT_PUBLIC_LOCAL_DAEMON_URL=http://127.0.0.1:4000

# Public URL embedded in the TV QR code (auto-detected from LAN IP in desktop dev mode):
# NEXT_PUBLIC_PUBLIC_WEB_URL=https://ktv.yourdomain.com
