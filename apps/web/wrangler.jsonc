{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "karawowke-web",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/app-router-entry",
	"assets": {
		"directory": "dist/client",
		"binding": "ASSETS",
		"html_handling": "none",
		"run_worker_first": [
			"/*",
			"!/_next/static/*",
			"!/*/_next/static/*"
		]
	},
	"vars": {
		"PI_DAEMON_API_URL": "http://127.0.0.1:4000"
	},
	"kv_namespaces": [
		{
			"binding": "SEARCH_CACHE",
			"id": "17fd1b9afd274de38f6169e302fce6db"
		}
	]
}
