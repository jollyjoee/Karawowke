{
  "name": "@ktv/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:preview": "vite build && wrangler dev --config dist/server/wrangler.json",
    "cf:deploy": "vite build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@ktv/shared": "workspace:*",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.2",
    "vinext": "^1.4.6",
    "vite": "^8.0.0",
    "vitest": "^3.1.1",
    "wrangler": "^4.166.0"
  }
}
