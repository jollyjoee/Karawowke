# Raspberry Pi Media Daemon Configuration
# Copy to .env for desktop dev, or /etc/ktv/daemon.env on Raspberry Pi.

PORT=4000
HOST=0.0.0.0

# Cache directory (defaults to ./.ktv-cache in dev; use /mnt/ktv-cache on Pi)
# CACHE_DIR=/mnt/ktv-cache
CACHE_MAX_GB=30

# Max downloaded video height (default 720p H.264/AAC MP4 playback)
MAX_VIDEO_HEIGHT=720

# Room security PINs (persisted to SQLite app_settings on first boot)
ROOM_PIN=1234
HOST_PIN=9999

# Optional shared secret header (x-daemon-token) for Cloudflare Worker -> Pi search fallback
# DAEMON_API_TOKEN=change-me-to-a-long-random-token

# Optional custom binary paths (defaults to 'yt-dlp' and 'ffmpeg' on PATH)
# YTDLP_BIN=yt-dlp
# FFMPEG_BIN=ffmpeg

# Optional YouTube cookies file (passed to yt-dlp only if file exists)
# YTDLP_COOKIES_PATH=/etc/ktv/youtube-cookies.txt

# Optional extra yt-dlp arguments for PO Token providers (space-separated, no shell interpolation)
# YTDLP_PO_TOKEN_ARGS=--extractor-args youtube:po_token=web+XXXX

# Web app port used for LAN phone-testing URL hints in desktop dev mode
WEB_PORT=3000

# Optional explicit public web URL (e.g. https://ktv.example.com)
# PUBLIC_WEB_URL=https://ktv.example.com
